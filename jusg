<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>PHRASTAFEST 2026 | Judgement Portal</title>

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:"Segoe UI",Arial,sans-serif;
}

body{
    background:#f4f7f5;
    color:#1f2937;
}

/* HEADER */

header{
    background:linear-gradient(135deg,#12372a,#1f6f50);
    color:white;
    padding:18px 6%;
    display:flex;
    justify-content:space-between;
    align-items:center;
    box-shadow:0 3px 15px rgba(0,0,0,.15);
}

.logo{
    font-size:23px;
    font-weight:800;
    letter-spacing:1px;
}

.header-right{
    font-size:14px;
}

/* MAIN */

.container{
    width:92%;
    max-width:1100px;
    margin:40px auto;
}

/* LOGIN */

.login-box{
    max-width:430px;
    margin:80px auto;
    background:white;
    padding:40px;
    border-radius:18px;
    box-shadow:0 10px 35px rgba(0,0,0,.08);
}

.login-box h1{
    text-align:center;
    color:#12372a;
    margin-bottom:8px;
}

.login-box p{
    text-align:center;
    color:#6b7280;
    margin-bottom:30px;
}

label{
    display:block;
    font-weight:600;
    margin-bottom:7px;
}

input,select{
    width:100%;
    padding:13px;
    border:1px solid #d1d5db;
    border-radius:9px;
    font-size:15px;
    margin-bottom:18px;
    outline:none;
}

input:focus,select:focus{
    border-color:#1f6f50;
}

button{
    border:none;
    cursor:pointer;
    border-radius:9px;
    padding:13px 20px;
    font-size:15px;
    font-weight:700;
}

.primary{
    width:100%;
    background:linear-gradient(135deg,#12372a,#1f6f50);
    color:white;
}

.secondary{
    background:#e7f1eb;
    color:#14532d;
}

.danger{
    background:#fee2e2;
    color:#991b1b;
}

.message{
    margin-top:15px;
    text-align:center;
    color:#b91c1c;
}

/* PORTAL */

.portal{
    display:none;
}

/* TITLE */

.page-title{
    text-align:center;
    margin-bottom:30px;
}

.page-title h1{
    color:#12372a;
    font-size:35px;
}

.page-title p{
    color:#6b7280;
    margin-top:6px;
}

/* CARDS */

.card{
    background:white;
    padding:30px;
    border-radius:18px;
    box-shadow:0 7px 25px rgba(0,0,0,.07);
    margin-bottom:25px;
}

.card h2{
    color:#12372a;
    margin-bottom:20px;
}

/* MARKS */

.criteria{
    display:grid;
    grid-template-columns:1fr 160px;
    gap:15px;
    align-items:center;
    margin-bottom:14px;
}

.criteria input{
    margin:0;
    text-align:center;
}

.total-box{
    margin-top:25px;
    background:#eef8f2;
    padding:20px;
    border-radius:12px;
    display:flex;
    justify-content:space-between;
    font-size:20px;
    font-weight:800;
    color:#166534;
}

.submit{
    width:100%;
    margin-top:25px;
    background:#12372a;
    color:white;
    padding:16px;
}

/* ADMIN */

.admin-panel{
    display:none;
}

.stats{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:20px;
    margin-bottom:25px;
}

.stat{
    background:white;
    padding:25px;
    border-radius:15px;
    text-align:center;
    box-shadow:0 5px 20px rgba(0,0,0,.06);
}

.stat h3{
    font-size:30px;
    color:#166534;
}

.stat p{
    color:#6b7280;
}

.table-wrapper{
    overflow-x:auto;
}

table{
    width:100%;
    border-collapse:collapse;
    min-width:800px;
}

th{
    background:#12372a;
    color:white;
    padding:13px;
    text-align:left;
}

td{
    padding:12px;
    border-bottom:1px solid #e5e7eb;
}

tr:nth-child(even){
    background:#f9fafb;
}

.rank{
    font-weight:800;
    color:#166534;
}

/* FOOTER */

footer{
    text-align:center;
    padding:30px;
    color:#6b7280;
}

/* MOBILE */

@media(max-width:700px){

    header{
        padding:15px 4%;
    }

    .container{
        width:94%;
    }

    .login-box{
        margin:40px auto;
        padding:25px;
    }

    .card{
        padding:20px;
    }

    .criteria{
        grid-template-columns:1fr 100px;
    }

    .stats{
        grid-template-columns:1fr;
    }

}

</style>
</head>

<body>

<header>

    <div class="logo">
        PHRASTAFEST '26
    </div>

    <div class="header-right">
        JUDGEMENT PORTAL
    </div>

</header>


<!-- ========================= -->
<!-- LOGIN -->
<!-- ========================= -->

<div id="loginPage">

    <div class="login-box">

        <h1>Judge Portal</h1>

        <p>
            PHRASTAFEST 2026<br>
            Department of Botany
        </p>

        <label>Username</label>

        <input
            type="text"
            id="username"
            placeholder="Enter username">


        <label>Password</label>

        <input
            type="password"
            id="password"
            placeholder="Enter password">


        <button
            class="primary"
            onclick="login()">

            LOGIN

        </button>

        <div
            class="message"
            id="loginMessage">
        </div>

    </div>

</div>


<!-- ========================= -->
<!-- JUDGE PORTAL -->
<!-- ========================= -->

<div
    class="portal"
    id="judgePortal">

<div class="container">

    <div class="page-title">

        <h1>Judgement Sheet</h1>

        <p>
            PHRASTAFEST 2026
            | Department of Botany
        </p>

    </div>


    <!-- PARTICIPANT -->

    <div class="card">

        <h2>Participant Details</h2>

        <label>Competition</label>

        <select id="event">

            <option value="">
                Select Competition
            </option>

            <option value="Botanical Quiz">
                Botanical Quiz
            </option>

            <option value="Plant Identification">
                Plant Identification
            </option>

            <option value="Poster Presentation">
                Poster Presentation
            </option>

            <option value="Essay Writing">
                Essay Writing
            </option>

            <option value="Photography">
                Photography
            </option>

        </select>


        <label>Registration Number</label>

        <input
            type="text"
            id="regNo"
            placeholder="Example: PHRASTA26-001">


        <label>Participant / Team Name</label>

        <input
            type="text"
            id="participant"
            placeholder="Enter participant name">


        <label>College</label>

        <input
            type="text"
            id="college"
            placeholder="Enter college name">

    </div>


    <!-- MARKS -->

    <div class="card">

        <h2>Enter Marks</h2>


        <div class="criteria">

            <label>
                Knowledge
                <small>(20)</small>
            </label>

            <input
                type="number"
                id="mark1"
                min="0"
                max="20"
                value="0"
                oninput="calculateTotal()">

        </div>


        <div class="criteria">

            <label>
                Presentation
                <small>(20)</small>
            </label>

            <input
                type="number"
                id="mark2"
                min="0"
                max="20"
                value="0"
                oninput="calculateTotal()">

        </div>


        <div class="criteria">

            <label>
                Creativity
                <small>(20)</small>
            </label>

            <input
                type="number"
                id="mark3"
                min="0"
                max="20"
                value="0"
                oninput="calculateTotal()">

        </div>


        <div class="criteria">

            <label>
                Accuracy
                <small>(20)</small>
            </label>

            <input
                type="number"
                id="mark4"
                min="0"
                max="20"
                value="0"
                oninput="calculateTotal()">

        </div>


        <div class="criteria">

            <label>
                Overall Performance
                <small>(20)</small>
            </label>

            <input
                type="number"
                id="mark5"
                min="0"
                max="20"
                value="0"
                oninput="calculateTotal()">

        </div>


        <div class="total-box">

            <span>Total Marks</span>

            <span>
                <span id="total">0</span> / 100
            </span>

        </div>


        <button
            class="submit"
            onclick="submitMarks()">

            SUBMIT MARKS

        </button>


        <div
            class="message"
            id="submitMessage">
        </div>

    </div>


    <button
        class="danger"
        onclick="logout()">

        LOGOUT

    </button>

</div>

</div>


<!-- ========================= -->
<!-- ADMIN PANEL -->
<!-- ========================= -->

<div
    class="admin-panel"
    id="adminPanel">

<div class="container">

    <div class="page-title">

        <h1>Admin Result Dashboard</h1>

        <p>
            PHRASTAFEST 2026
        </p>

    </div>


    <div class="stats">

        <div class="stat">

            <h3 id="participantCount">
                0
            </h3>

            <p>Entries</p>

        </div>


        <div class="stat">

            <h3 id="highestMark">
                0
            </h3>

            <p>Highest Mark</p>

        </div>


        <div class="stat">

            <h3 id="averageMark">
                0
            </h3>

            <p>Average</p>

        </div>

    </div>


    <div class="card">

        <h2>Results</h2>

        <button
            class="secondary"
            onclick="downloadCSV()">

            📥 DOWNLOAD CSV

        </button>

        <button
            class="danger"
            onclick="clearResults()">

            🗑 CLEAR ALL

        </button>

        <br><br>

        <div class="table-wrapper">

            <table>

                <thead>

                    <tr>

                        <th>Rank</th>
                        <th>Registration No.</th>
                        <th>Participant</th>
                        <th>College</th>
                        <th>Competition</th>
                        <th>Total</th>

                    </tr>

                </thead>

                <tbody id="resultTable">

                </tbody>

            </table>

        </div>

    </div>


    <button
        class="danger"
        onclick="logout()">

        LOGOUT

    </button>

</div>

</div>


<footer>

    <strong>PHRASTAFEST 2026</strong>

    <br>

    Department of Botany

    <br>

    St. Joseph's College (Autonomous),
    Tiruchirappalli – 2

</footer>


<script>

/* ==================================
   LOGIN
================================== */

function login(){

    const username =
        document.getElementById("username").value.trim();

    const password =
        document.getElementById("password").value;

    /*
       DEMO LOGIN

       Judge:
       username = judge
       password = judge123

       Admin:
       username = admin
       password = admin123
    */

    if(username === "judge" && password === "judge123"){

        document.getElementById("loginPage")
            .style.display = "none";

        document.getElementById("judgePortal")
            .style.display = "block";

    }

    else if(username === "admin" && password === "admin123"){

        document.getElementById("loginPage")
            .style.display = "none";

        document.getElementById("adminPanel")
            .style.display = "block";

        loadResults();

    }

    else{

        document.getElementById("loginMessage")
            .textContent =
            "Invalid username or password.";

    }

}


/* ==================================
   CALCULATE TOTAL
================================== */

function calculateTotal(){

    let m1 = Number(document.getElementById("mark1").value);
    let m2 = Number(document.getElementById("mark2").value);
    let m3 = Number(document.getElementById("mark3").value);
    let m4 = Number(document.getElementById("mark4").value);
    let m5 = Number(document.getElementById("mark5").value);

    let total =
        m1 + m2 + m3 + m4 + m5;

    document.getElementById("total")
        .textContent = total;

}


/* ==================================
   SUBMIT MARKS
================================== */

function submitMarks(){

    const event =
        document.getElementById("event").value;

    const regNo =
        document.getElementById("regNo").value.trim();

    const participant =
        document.getElementById("participant").value.trim();

    const college =
        document.getElementById("college").value.trim();

    if(!event || !regNo || !participant || !college){

        document.getElementById("submitMessage")
            .textContent =
            "Please complete all participant details.";

        return;
    }


    let marks = [

        Number(document.getElementById("mark1").value),

        Number(document.getElementById("mark2").value),

        Number(document.getElementById("mark3").value),

        Number(document.getElementById("mark4").value),

        Number(document.getElementById("mark5").value)

    ];


    let total =
        marks.reduce(
            (sum,value) => sum + value,
            0
        );


    let results =
        JSON.parse(
            localStorage.getItem("phrastafestResults")
        ) || [];


    /*
       Prevent duplicate registration/event
    */

    const duplicate =
        results.some(
            r =>
            r.regNo.toLowerCase() ===
            regNo.toLowerCase()
            &&
            r.event === event
        );


    if(duplicate){

        document.getElementById("submitMessage")
            .textContent =
            "Marks already submitted for this participant and competition.";

        return;
    }


    const record = {

        regNo: regNo,

        participant: participant,

        college: college,

        event: event,

        mark1: marks[0],

        mark2: marks[1],

        mark3: marks[2],

        mark4: marks[3],

        mark5: marks[4],

        total: total,

        date:
            new Date().toLocaleString()

    };


    results.push(record);


    localStorage.setItem(
        "phrastafestResults",
        JSON.stringify(results)
    );


    document.getElementById("submitMessage")
        .style.color = "#166534";

    document.getElementById("submitMessage")
        .textContent =
        "✓ Marks submitted successfully.";


    /*
       Clear form
    */

    document.getElementById("event").value = "";

    document.getElementById("regNo").value = "";

    document.getElementById("participant").value = "";

    document.getElementById("college").value = "";

    for(let i=1;i<=5;i++){

        document.getElementById("mark"+i)
            .value = 0;

    }

    calculateTotal();

}


/* ==================================
   LOAD RESULTS
================================== */

function loadResults(){

    let results =
        JSON.parse(
            localStorage.getItem("phrastafestResults")
        ) || [];


    /*
       Sort highest marks first
    */

    results.sort(
        (a,b) => b.total - a.total
    );


    const table =
        document.getElementById("resultTable");

    table.innerHTML = "";


    results.forEach((r,index)=>{

        const row =
            document.createElement("tr");


        row.innerHTML = `

            <td class="rank">
                ${index + 1}
            </td>

            <td>
                ${escapeHTML(r.regNo)}
            </td>

            <td>
                ${escapeHTML(r.participant)}
            </td>

            <td>
                ${escapeHTML(r.college)}
            </td>

            <td>
                ${escapeHTML(r.event)}
            </td>

            <td>
                <strong>
                    ${r.total}/100
                </strong>
            </td>

        `;

        table.appendChild(row);

    });


    document.getElementById("participantCount")
        .textContent = results.length;


    if(results.length > 0){

        const highest =
            Math.max(
                ...results.map(r => r.total)
            );

        const average =
            results.reduce(
                (sum,r)=>sum+r.total,
                0
            ) / results.length;


        document.getElementById("highestMark")
            .textContent = highest;

        document.getElementById("averageMark")
            .textContent =
            average.toFixed(2);

    }

}


/* ==================================
   DOWNLOAD CSV
================================== */

function downloadCSV(){

    let results =
        JSON.parse(
            localStorage.getItem("phrastafestResults")
        ) || [];


    if(results.length === 0){

        alert("No results available.");

        return;

    }


    /*
       Sort results
    */

    results.sort(
        (a,b) => b.total - a.total
    );


    let csv =
        "Rank,Registration No,Participant,College,Competition,Knowledge,Presentation,Creativity,Accuracy,Overall Performance,Total,Date\n";


    results.forEach((r,index)=>{

        csv += [

            index + 1,

            csvValue(r.regNo),

            csvValue(r.participant),

            csvValue(r.college),

            csvValue(r.event),

            r.mark1,

            r.mark2,

            r.mark3,

            r.mark4,

            r.mark5,

            r.total,

            csvValue(r.date)

        ].join(",") + "\n";

    });


    const blob =
        new Blob(
            [csv],
            {
                type:"text/csv;charset=utf-8;"
            }
        );


    const url =
        URL.createObjectURL(blob);


    const link =
        document.createElement("a");


    link.href = url;

    link.download =
        "PHRASTAFEST_2026_RESULTS.csv";


    link.click();


    URL.revokeObjectURL(url);

}


/* ==================================
   CSV SAFE VALUE
================================== */

function csvValue(value){

    value = String(value || "");

    return '"' +
        value.replace(/"/g,'""') +
        '"';

}


/* ==================================
   SECURITY FOR TABLE DISPLAY
================================== */

function escapeHTML(value){

    return String(value)
        .replace(/&/g,"&amp;")
        .replace(/</g,"&lt;")
        .replace(/>/g,"&gt;")
        .replace(/"/g,"&quot;")
        .replace(/'/g,"&#039;");

}


/* ==================================
   CLEAR RESULTS
================================== */

function clearResults(){

    const confirmDelete =
        confirm(
            "WARNING!\n\n" +
            "This will permanently remove all results stored in this browser.\n\n" +
            "Continue?"
        );


    if(confirmDelete){

        localStorage.removeItem(
            "phrastafestResults"
        );

        loadResults();

    }

}


/* ==================================
   LOGOUT
================================== */

function logout(){

    location.reload();

}

</script>

</body>
</html>
